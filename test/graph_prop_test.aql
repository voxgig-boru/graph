# graph — prop (test) suite.
#
# PLACEHOLDER. The library is designed but not implemented (see
# DESIGN.md), so there is nothing to assert yet. The file exists to hold
# the naming convention and keep CI green; add real cases alongside the
# first implemented word.
#
# Run:
#   boru test/graph_prop_test.aql

# The library is imported BEFORE boru:test on purpose: on boru main @
# 64c5ab2, boru:test mints its record types from a fresh type-ID counter, so
# a library class imported after it can collide with one of them and fail
# its own return-type check ("expected X, got X"). See dx-report.md.
import "../graph.aql"
import "boru:test"

# --- summary -------------------------------------------------------

# One value per `print (…)` statement: a postfix `"x" print` chain collects
# forward and prints out of order.
print ("---")
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print ("all green")
